# Copy this file to .env and fill in the values.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Only this Telegram user id can control the bot
ALLOWED_TELEGRAM_USER_ID=8025094859

# API keys. You can list multiple keys separated by commas — the bot rotates
# them and switches when one hits its rate limit or is exhausted.
BLOCKSCOUT_API_KEYS=
RELAY_API_KEYS=

# DexPaprika network slug for Robinhood Chain (primary price/marketcap/liquidity source)
DEXPAPRIKA_NETWORK=robinhood
